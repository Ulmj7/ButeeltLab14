								"type": "text/javascript",
								"exec": [
									"pm.test('Delete: status 200', () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"var data = pm.response.json();",
									"",
									"pm.test('Delete: isDeleted flag is true', () => {",
									"    pm.expect(data.isDeleted).to.eql(true);",
									"});",
									"",
									"pm.test('Delete: deletedOn is a string (ISO date)', () => {",
									"    pm.expect(data.deletedOn).to.be.a('string');",
									"    pm.expect(data.deletedOn.length).to.be.above(0);",
									"});"
								]
							}
						}
