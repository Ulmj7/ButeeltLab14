{
	"info": {
		"_postman_id": "b8e3f9a4-2c5d-4e7f-9b1a-0123456789ab",
		"name": "Ulmj — DummyJSON",
		"description": "F.CSM311 Бие даалт 14 — DummyJSON public API дээр integration тест. Auth, Products, Errors гэсэн 3 folder-т нийт 8 request, 25+ assertion.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{accessToken}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Auth",
			"description": "Нэвтрэх ба хамгаалагдсан endpoint",
			"item": [
				{
					"name": "Login",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Username/password-аар нэвтэрч accessToken, userId-г environment-д хадгална."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Login: status 200', () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Login: response time < 2000ms', () => {",
									"    pm.expect(pm.response.responseTime).to.be.below(2000);",
									"});",
									"",
									"var data = pm.response.json();",
									"",
									"pm.test('Login: response has accessToken property', () => {",
									"    pm.expect(data).to.have.property('accessToken');",
									"});",
									"",
									"pm.test('Login: accessToken is a non-empty string', () => {",
									"    pm.expect(data.accessToken).to.be.a('string');",
									"    pm.expect(data.accessToken.length).to.be.above(20);",
									"});",
									"",
									"pm.test('Login: email matches a basic email pattern', () => {",
									"    pm.expect(data.email).to.match(/.+@.+\\..+/);",
									"});",
									"",
									"// Chain: дараагийн request-уудад хувьсагч дамжуулна",
									"pm.environment.set('accessToken', data.accessToken);",
									"pm.environment.set('userId', data.id);"
								]
							}
						}
					]
				},
				{
					"name": "Get my info",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/auth/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"me"
							]
						},
						"description": "Login-оос авсан {{accessToken}}-ыг ашиглан өөрийн profile-ыг авна (chained request)."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Me: status 200', () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"var data = pm.response.json();",
									"",
									"pm.test('Me: id matches userId saved at login', () => {",
									"    pm.expect(data.id).to.eql(Number(pm.environment.get('userId')));",
									"});",
									"",
									"pm.test('Me: id is a number', () => {",
									"    pm.expect(data.id).to.be.a('number');",
									"});",
									"",
									"pm.test('Me: email property exists and looks valid', () => {",
									"    pm.expect(data).to.have.property('email');",
									"    pm.expect(data.email).to.match(/.+@.+\\..+/);",
									"});"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "Products",
			"description": "Бүтээгдэхүүний CRUD",
			"item": [
				{
					"name": "List products",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/products?limit=10",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"products"
							],
							"query": [
								{
									"key": "limit",
									"value": "10"
								}
							]
						},
						"description": "Эхний 10 бүтээгдэхүүний жагсаалт (Happy GET)."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('List: status 200', () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('List: Content-Type header is JSON', () => {",
									"    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
									"});",
									"",
									"var data = pm.response.json();",
									"",
									"pm.test('List: response has products array', () => {",
									"    pm.expect(data).to.have.property('products');",
									"    pm.expect(data.products).to.be.an('array');",
									"});",
									"",
									"pm.test('List: products array has at least 1 item', () => {",
									"    pm.expect(data.products.length).to.be.above(0);",
									"});",
									"",
									"pm.test('List: total is a positive number', () => {",
									"    pm.expect(data.total).to.be.a('number');",
									"    pm.expect(data.total).to.be.above(0);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Get product by id",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/products/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"products",
								"1"
							]
						},
						"description": "id = 1 бүтээгдэхүүнийг авна."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Get by id: status 200', () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Get by id: response time < 2000ms', () => {",
									"    pm.expect(pm.response.responseTime).to.be.below(2000);",
									"});",
									"",
									"var data = pm.response.json();",
									"",
									"pm.test('Get by id: id is exactly 1', () => {",
