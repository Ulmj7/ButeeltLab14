									"});",
									"",
									"pm.test('Get by id: price is a positive number', () => {",
									"    pm.expect(data.price).to.be.a('number');",
									"    pm.expect(data.price).to.be.above(0);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Add product",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"{{randomTitle}}\",\n  \"price\": 19.99\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/products/add",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"products",
								"add"
							]
						},
						"description": "Pre-request script-ээр random title үүсгэж шинэ бүтээгдэхүүн нэмнэ. Шинэ id-г хадгална."
					},
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Arrange: давтагдашгүй title үүсгэх (timestamp + санамсаргүй тоо)",
									"const ts = Date.now();",
									"const rnd = Math.floor(Math.random() * 1000);",
									"const title = `Test Product ${ts}-${rnd}`;",
									"pm.environment.set('randomTitle', title);"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Add: status 201', () => {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"var data = pm.response.json();",
									"",
									"pm.test('Add: response has new id', () => {",
									"    pm.expect(data).to.have.property('id');",
									"    pm.expect(data.id).to.be.a('number');",
									"    pm.expect(data.id).to.be.above(0);",
									"});",
									"",
									"pm.test('Add: title matches the random title we sent', () => {",
									"    pm.expect(data.title).to.eql(pm.environment.get('randomTitle'));",
									"});",
									"",
									"// Chain: дараагийн request-уудад дамжуулж болохуйц шинэ id-г хадгална",
									"pm.environment.set('createdProductId', data.id);"
								]
							}
						}
					]
				},
				{
					"name": "Update product",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Updated title\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/products/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"products",
								"1"
							]
						},
						"description": "Бүтээгдэхүүн id=1-ийн title-ыг шинэчлэнэ."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Update: status 200', () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"var data = pm.response.json();",
									"",
									"pm.test('Update: title is updated to new value', () => {",
									"    pm.expect(data.title).to.eql('Updated title');",
									"});",
									"",
									"pm.test('Update: id is preserved', () => {",
									"    pm.expect(data.id).to.eql(1);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Delete product",
					"request": {
